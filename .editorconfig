# EditorConfig keeps basic formatting the same in every editor.
# Most editors support it, some through a plugin: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Go code and Makefiles are indented with tabs: gofmt and make require it.
[{*.go,go.mod}]
indent_style = tab
indent_size = 4

[{Makefile,*.mk}]
indent_style = tab
indent_size = 4

[*.{yml,yaml,json,md}]
indent_style = space
indent_size = 2

# Two spaces at the end of a Markdown line are a line break, so keep them.
[*.md]
trim_trailing_whitespace = false
